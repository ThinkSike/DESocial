# ----------------------------------------------
# When you get a domain, replace the line below:
# ----------------------------------------------
# :443 {
#     tls internal { on_demand }
#     reverse_proxy server:3000
# }
# ----------------------------------------------
# with:
# ----------------------------------------------
# yourdomain.com {
#     reverse_proxy server:3000
# }
# ----------------------------------------------
# Caddy will auto-fetch a free Let's Encrypt cert.

:443 {
    tls internal {
        on_demand
    }
    reverse_proxy server:3000
}

http://:80 {
    redir https://{host}{uri}
}
